rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper: Access Firestore to check if requester is Active
    function isActive() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == "Active";
    }

    // Helper: Check if user holds a specific administrative permission in Firestore
    function hasPermission(permission) {
      return isActive() &&
        (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.permissions.hasAny(["*"]) ||
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.permissions.hasAny([permission])
        );
    }

    // Website admin media assets (blogs, solutions images)
    match /media/{allPaths=**} {
      allow read: if true; // Publicly readable
      allow write: if request.auth != null && (
        hasPermission("manage_blogs") || 
        hasPermission("manage_solutions") || 
        hasPermission("manage_settings")
      );
    }

    // Public user-specific uploads (e.g. comments attachments or avatars if used)
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && isActive();
    }
  }
}
